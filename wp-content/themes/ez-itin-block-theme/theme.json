{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1120px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#0A2540",
          "name": "Deep Text"
        },
        {
          "slug": "navy",
          "color": "#0A2540",
          "name": "Deep Text (Legacy)"
        },
        {
          "slug": "blue",
          "color": "#005EFF",
          "name": "Cobalt Action"
        },
        {
          "slug": "cyan",
          "color": "#12B886",
          "name": "Emerald Teal"
        },
        {
          "slug": "paper",
          "color": "#EDF2FB",
          "name": "Light Blue"
        },
        {
          "slug": "teal-soft",
          "color": "#E7F8F3",
          "name": "Soft Teal"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "line",
          "color": "#CFDDEC",
          "name": "Line"
        },
        {
          "slug": "muted",
          "color": "#526983",
          "name": "Muted"
        }
      ],
      "duotone": [],
      "gradients": [
        {
          "slug": "hero",
          "gradient": "linear-gradient(135deg,#FFFFFF 0%,#EDF2FB 58%,#E7F8F3 100%)",
          "name": "Light Fintech Hero"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "30",
          "size": "0.75rem",
          "name": "SM"
        },
        {
          "slug": "40",
          "size": "1rem",
          "name": "MD"
        },
        {
          "slug": "50",
          "size": "1.5rem",
          "name": "LG"
        },
        {
          "slug": "60",
          "size": "2rem",
          "name": "XL"
        },
        {
          "slug": "70",
          "size": "3rem",
          "name": "2XL"
        },
        {
          "slug": "80",
          "size": "5rem",
          "name": "3XL"
        }
      ],
      "units": [
        "%",
        "px",
        "rem",
        "vw"
      ]
    },
    "typography": {
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "body",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "Inter"
        },
        {
          "slug": "display",
          "fontFamily": "\"Plus Jakarta Sans\", Inter, ui-sans-serif, system-ui, sans-serif",
          "name": "Plus Jakarta Sans"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Body"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Lead"
        },
        {
          "slug": "x-large",
          "size": "clamp(2.25rem, 5vw, 4.5rem)",
          "name": "Hero"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "lineHeight": true
    }
  },
  "styles": {
    "color": {
      "text": "var:preset|color|ink",
      "background": "var:preset|color|white"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "800",
          "lineHeight": "1.12"
        },
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|blue"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var:preset|color|blue",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.25rem",
            "right": "1.25rem"
          }
        },
        "typography": {
          "fontWeight": "700"
        }
      }
    }
  }
}
